</tr>
<tr>
<td>16 til 30 minutter</td>
<td><!-- A2616_2 --></td>
</tr>
<tr>
<td>5 til 15 minutter</td>
<td><!-- A2616_3 --></td>
</tr>
<tr>
<td>Kun meget korte afstande</td>
<td><!-- A2616_4 --></td>
</tr>
<tr>
<td>Det er helt umuligt at gå</td>
<td><!-- A2616_5 --></td>
</tr>
<tr>
