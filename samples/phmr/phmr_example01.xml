			<id
				assigningAuthorityName="CPR"
				extension="0103660140"
				root="1.2.208.176.1.2"/>
			<!-- The patient is self-reporting the measurements -->
			<code
				code="SELF"
				codeSystem="2.16.840.1.113883.5.111"
				codeSystemName="HL7 Role code"
