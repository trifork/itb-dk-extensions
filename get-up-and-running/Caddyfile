# Caddy obtains and renews the hostname's certificate and redirects HTTP to HTTPS.
https://{$ITB_HTTPS_HOST} {
	# Apply one consistent policy after upstream headers, including on errors.
	header >Strict-Transport-Security "max-age=31536000"
	# Preserve the applications' CSP, including validator script nonces.
	@callbacks path /itbsrv /itbsrv/*
	handle @callbacks {
		reverse_proxy gitb-srv:8080
	}
	handle {
		# Includes the frontend, API, WebSockets and same-origin /cda-preview.
		reverse_proxy gitb-ui-gateway:9000
	}
}

# The standalone validator has its own assets/API paths. Preserve its root and
# use a separate HTTPS port, with the same hostname and certificate.
https://{$ITB_HTTPS_HOST}:8443 {
	header >Strict-Transport-Security "max-age=31536000"
	reverse_proxy cda-validator:8080
}
