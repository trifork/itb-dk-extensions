					<text>
						<paragraph>Mange tak for din deltagelse.<br/>Med venlig hilsen</paragraph>
					</text>
					<languageCode code="da-DK"/>
				</section>
			</component>

			<!-- This component defines the copyright section -->
			<component contextConductionInd="true" typeCode="COMP">
				<section classCode="DOCSECT" moodCode="EVN">
					<!--templateID for the Copyright Section-->
					<templateId root="2.16.840.1.113883.10.20.32.2.2"/>
					<title>Copyright titel skrives her [Title, Copy Right Section]</title>
					<text>
						<paragraph>Copyright tekst skrives her</paragraph>
					</text>
					<languageCode code="da-DK"/>
					<entry contextConductionInd="true" typeCode="COMP">
